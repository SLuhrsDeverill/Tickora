# Database
DATABASE_URL=postgresql://helpdesk:helpdesk_pass@localhost:5433/helpdesk_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_strong_random_string_min_32_chars
JWT_REFRESH_SECRET=another_strong_random_string_for_refresh_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Email (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=helpdesk@empresa.com

# Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_FILES=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# IA / Bot
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=1000

# Admin inicial (usado en seed de producción)
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=           # dejar vacío para generar automáticamente
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Sistema

# Empresa
COMPANY_NAME=Tickora
COMPANY_LOGO_URL=

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5174
