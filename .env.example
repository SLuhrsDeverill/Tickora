# Database
DATABASE_URL=postgresql://helpdesk:helpdesk_pass@localhost:5432/helpdesk_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change_this_to_a_strong_random_string_min_32_chars
JWT_REFRESH_SECRET=another_strong_random_string_for_refresh_tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=helpdesk@empresa.com

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
